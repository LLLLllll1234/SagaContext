#!/bin/sh
HOST="$1"
EVENT="$2"
PORT="${SAGACTL_PORT:-37780}"
HOST_VERSION="${SAGACONTEXT_HOST_VERSION:-}"
GENERATION="${SAGACONTEXT_GENERATION:-}"
TMP=$(mktemp "${TMPDIR:-/tmp}/sagactl-hook.XXXXXX")
cat > "$TMP"
OUT=$(curl -s -m 0.8 -H 'Content-Type: application/json' \
  -H "X-SagaContext-Host-Version: ${HOST_VERSION}" \
  -H "X-SagaContext-Generation: ${GENERATION}" \
  --data-binary "@$TMP" "http://127.0.0.1:${PORT}/events?host=${HOST}&event=${EVENT}" 2>/dev/null)
RC=$?
if [ "$RC" -ne 0 ]; then
  if [ "$RC" -eq 7 ] && command -v sagacontext-daemon >/dev/null 2>&1; then
    nohup sagacontext-daemon >/dev/null 2>&1 &
    sleep 0.15
    OUT=$(curl -s -m 0.8 -H 'Content-Type: application/json' \
      -H "X-SagaContext-Host-Version: ${HOST_VERSION}" -H "X-SagaContext-Generation: ${GENERATION}" \
      --data-binary "@$TMP" "http://127.0.0.1:${PORT}/events?host=${HOST}&event=${EVENT}" 2>/dev/null)
  fi
  echo '{}'
else
  [ -n "$OUT" ] && printf '%s\n' "$OUT" || echo '{}'
fi
rm -f "$TMP"
exit 0
